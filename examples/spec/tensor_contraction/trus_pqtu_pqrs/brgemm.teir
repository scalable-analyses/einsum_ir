teir-format 1.0

teir @trus_pqtu_pqrs_brgemm {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32

  axis @p extent 3 strides { in1: 32, out: 96 }
  axis @q extent 2 strides { in1: 16, out: 48 }
  axis @r extent 3 strides { in0: 32, out: 16 }
  axis @s extent 4 strides { in0: 4, out: 4 }
  axis @t extent 2 strides { in0: 96, in1: 8 }
  axis @u extent 2 strides { in0: 16, in1: 4 }

  primitive @zero_sq : Zero axes { M: [@s], N: [@q] } metadata { data_type: f32 }
  primitive @brgemm_sqtu : Contraction axes { M: [@s], N: [@q], K: [@t, @u] } metadata { data_type: f32 }

  schedule {
    roots [@iter_p]

    iter @iter_r axis @r policy parallel children [@inv_zero, @inv_brgemm]
    iter @iter_p axis @p policy parallel children [@iter_r]
    invoke @inv_zero primitive @zero_sq
    invoke @inv_brgemm primitive @brgemm_sqtu
  }
}
