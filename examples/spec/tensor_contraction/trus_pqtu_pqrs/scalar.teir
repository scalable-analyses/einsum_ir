teir-format 1.0

teir @trus_pqtu_pqrs_scalar {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32

  axis @p extent 3 strides { in1: 32, out: 96 }
  axis @q extent 2 strides { in1: 16, out: 48 }
  axis @r extent 3 strides { in0: 32, out: 16 }
  axis @s extent 4 strides { in0: 4, out: 4 }
  axis @t extent 2 strides { in0: 96, in1: 8 }
  axis @u extent 2 strides { in0: 16, in1: 4 }

  primitive @zero : Zero axes { M: [], N: [] } metadata { data_type: f32 }
  primitive @contraction : Contraction axes { M: [], N: [], K: [] } metadata { data_type: f32 }

  schedule {
    roots [@iter_p]

    iter @iter_u axis @u policy sequential children [@inv_contract]
    iter @iter_t axis @t policy sequential children [@iter_u]
    iter @iter_s axis @s policy sequential children [@inv_zero, @iter_t]
    iter @iter_r axis @r policy sequential children [@iter_s]
    iter @iter_q axis @q policy sequential children [@iter_r]
    iter @iter_p axis @p policy sequential children [@iter_q]
    invoke @inv_zero primitive @zero
    invoke @inv_contract primitive @contraction
  }
}
