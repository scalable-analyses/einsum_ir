teir-format 1.0

teir @dba_dac_dbc_scalar {
  tensor %in0 : f32
  tensor %in1 : f32
  tensor %out : f32

  axis @d extent 2 strides { in0: 60, in1: 80, out: 48 }
  axis @b extent 3 strides { in0: 20, out: 16 }
  axis @c extent 4 strides { in1: 4, out: 4 }
  axis @a extent 5 strides { in0: 4, in1: 16 }

  primitive @zero : Zero axes { M: [], N: [] } metadata { data_type: f32 }
  primitive @contraction : Contraction axes { M: [], N: [], K: [] } metadata { data_type: f32 }

  schedule {
    roots [@iter_a]

    iter @iter_d axis @d policy sequential children [@inv_zero, @inv_contract]
    iter @iter_c axis @c policy sequential children [@iter_d]
    iter @iter_b axis @b policy sequential children [@iter_c]
    iter @iter_a axis @a policy sequential children [@iter_b]
    invoke @inv_zero primitive @zero guard first(@iter_a)
    invoke @inv_contract primitive @contraction
  }
}
