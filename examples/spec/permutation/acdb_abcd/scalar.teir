teir-format 1.0

teir @acdb_abcd_scalar {
  tensor %in0 : f32
  tensor %out : f32

  axis @a extent 60 strides { in0: 96000, out: 96000 }
  axis @c extent 20 strides { in0: 4800, out: 80 }
  axis @d extent 20 strides { in0: 240, out: 4 }
  axis @b extent 60 strides { in0: 4, out: 1600 }

  primitive @copy : Copy axes { M: [], N: [] } metadata { data_type: f32 }

  schedule {
    roots [@c0]

    iter @c3 axis @b policy sequential children [@i0]
    iter @c2 axis @d policy sequential children [@c3]
    iter @c1 axis @c policy sequential children [@c2]
    iter @c0 axis @a policy sequential children [@c1]
    invoke @i0 primitive @copy
  }
}
