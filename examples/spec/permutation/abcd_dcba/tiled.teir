teir-format 1.0

teir @abcd_dcba_tiled {
  tensor %in0 : f32
  tensor %out : f32

  axis @a extent 2 strides { in0: 240, out: 4 }
  axis @b extent 3 strides { in0: 80, out: 8 }
  axis @c extent 4 strides { in0: 20, out: 24 }
  axis @d extent 5 strides { in0: 4, out: 96 }

  primitive @copy_da : Copy axes { M: [@d], N: [@a] } metadata { data_type: f32 }

  schedule {
    roots [@iter_b]

    iter @iter_c axis @c policy sequential children [@copy]
    iter @iter_b axis @b policy sequential children [@iter_c]
    invoke @copy primitive @copy_da
  }
}
